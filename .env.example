# OpenAI-compatible API
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=your-model

# Query listeners
NORMAL_ADDR=127.0.0.1:8887
VIP_ADDR=127.0.0.1:8888
MAX_QUERY_COUNT=100
NEWS_CATEGORIES='[
    {"name": "时政", "description": "各国政治活动、政府决策、国家治理、选举、政党、政策制定与实施、外交关系、国际组织及地缘政治等新闻，重点关注政治权力、政府行为和国家间关系"},
    {"name": "军事", "description": "战争、武装冲突、军事行动、国防建设、军队动态、军事演习、武器装备、军事技术、军事战略及国际军事安全等新闻"},
    {"name": "财经", "description": "宏观经济、经济政策、金融市场、股票、基金、债券、银行、保险、外汇、货币政策、国际贸易、投资融资及经济运行数据等新闻"},
    {"name": "商业", "description": "企业经营、公司发展、企业财报、商业竞争、商业合作、兼并收购、品牌运营、商业模式、创业活动及企业管理等新闻"},
    {"name": "科技", "description": "人工智能、互联网、计算机、通信、半导体、软件、硬件、机器人、数字技术、科学研究、航空航天、基础科学、科研成果及技术创新等新闻"},
    {"name": "产业", "description": "工业制造、汽车制造、能源、矿业、农业生产、建筑、房地产、物流、交通运输、产业链、供应链、产能建设及实体产业发展等新闻"},
    {"name": "社会", "description": "社会现象、公众事件、社会矛盾、社会公平、社会群体、社会舆论、民间活动、公共争议、人际关系及具有广泛社会影响的热点新闻"},
    {"name": "民生", "description": "居民日常生活、就业、收入、住房保障、社会福利、养老、婚育、人口、公共服务、物价对居民生活的影响及生活质量等新闻"},
    {"name": "法治", "description": "法律法规、司法审判、重大案件、刑事犯罪、民事纠纷、行政执法、警务调查、反腐败、法律责任、司法改革及社会治安等新闻"},
    {"name": "教育", "description": "学校教育、基础教育、高等教育、职业教育、考试招生、教育改革、教育政策、教学活动、学生发展、教师群体、教育资源及人才培养等新闻"},
    {"name": "健康", "description": "医疗服务、疾病防治、公共卫生、传染病、医药研发、医疗技术、医院管理、医疗政策、心理健康、食品健康风险及居民健康等新闻"},
    {"name": "文娱", "description": "电影、电视剧、音乐、文学、艺术、明星、综艺、演出、动漫、电子游戏、文化作品、娱乐产业、文化活动及娱乐人物等新闻"},
    {"name": "体育", "description": "体育赛事、运动员、体育俱乐部、体育组织、竞技成绩、体育产业、体育政策、全民健身及电子竞技赛事等新闻"},
    {"name": "生态", "description": "自然环境、气候变化、环境污染、生态保护、生物多样性、野生动植物、自然资源保护、碳排放、环境治理及可持续发展等新闻"},
    {"name": "突发", "description": "地震、洪水、台风、火灾、重大事故、爆炸、建筑坍塌、交通事故、人员失踪、大规模伤亡、应急救援及其他突然发生并需要即时处置的重大事件"},
    {"name": "其他", "description": "无法合理归入其他类别的新闻，包括宗教信仰、民族习俗、历史考古、奇闻趣事及其他独立主题，或因内容严重缺失而无法判断主题的新闻；仅在所有已有类别均不适用时使用"}
]'

# These ports always bind to 127.0.0.1
COLLECTOR_PORT=8886
ADMIN_PORT=8889

# Storage and analysis worker
DATABASE_PATH=./data/newsscope.db
ANALYSIS_WORKERS=3
ANALYSIS_MAX_ATTEMPTS=5
ANALYSIS_TIMEOUT_SECONDS=600
ANALYSIS_MAX_BODY_CHARS=300000
ANALYSIS_MAX_DUPLICATE_DIFF_CHARS=30000
ANALYSIS_MAX_SUMMARY_CHARS=120

# Docker container preset: RSSHub + Redis + NewsScope + the RSSHub collector.
# Copy this file to .env and replace the OpenAI-compatible API credentials above.
RSSHUB_IMAGE=ghcr.io/diygod/rsshub:chromium-bundled-d55daa06c1340db6fa9cc5f865f627748eb5b346
RSSHUB_CACHE_EXPIRE=300
RSSHUB_CONTENT_CACHE_EXPIRE=3600
RSSHUB_REDIS_MAXMEMORY=256mb
RSSHUB_POLL_INTERVAL=10
RSSHUB_POLL_WORKERS=4

# Published ports bind to localhost by default. Set a bind IP explicitly to expose one.
RSSHUB_BIND=127.0.0.1
RSSHUB_PORT=1200
PANEL_BIND=127.0.0.1
PANEL_PORT=8885
COLLECTOR_BIND=127.0.0.1
COLLECTOR_HOST_PORT=8886
NORMAL_BIND=127.0.0.1
NORMAL_HOST_PORT=8887
VIP_BIND=127.0.0.1
VIP_HOST_PORT=8888
