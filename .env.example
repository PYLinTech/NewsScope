# OpenAI-compatible API
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=your-model

# Query listeners
NORMAL_ADDR=127.0.0.1:8887
VIP_ADDR=127.0.0.1:8888
MAX_QUERY_COUNT=100
NEWS_CATEGORIES=时政,科技,财经,文旅,社会,商业,教育,健康,国际

# These ports always bind to 127.0.0.1
COLLECTOR_PORT=8886
ADMIN_PORT=8889

# Storage and analysis worker
DATABASE_PATH=./data/newsscope.db
ANALYSIS_WORKERS=3
ANALYSIS_MAX_ATTEMPTS=5
ANALYSIS_TIMEOUT_SECONDS=45
ANALYSIS_MAX_BODY_CHARS=12000
ANALYSIS_MAX_SUMMARY_CHARS=120

# Docker container preset: RSSHub + Redis + NewsScope + the RSSHub collector.
# Copy this file to .env and replace the OpenAI-compatible API credentials above.
RSSHUB_IMAGE=ghcr.io/diygod/rsshub:chromium-bundled-d55daa06c1340db6fa9cc5f865f627748eb5b346
RSSHUB_CACHE_EXPIRE=300
RSSHUB_CONTENT_CACHE_EXPIRE=3600
RSSHUB_REDIS_MAXMEMORY=256mb
RSSHUB_POLL_INTERVAL=300
RSSHUB_POLL_WORKERS=4

# Published ports bind to localhost by default. Set a bind IP explicitly to expose one.
RSSHUB_BIND=127.0.0.1
RSSHUB_PORT=1200
PANEL_BIND=127.0.0.1
PANEL_PORT=8885
COLLECTOR_BIND=127.0.0.1
COLLECTOR_HOST_PORT=8886
NORMAL_BIND=127.0.0.1
NORMAL_HOST_PORT=8887
VIP_BIND=127.0.0.1
VIP_HOST_PORT=8888
