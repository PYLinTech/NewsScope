# OpenAI-compatible API
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=your-model

# Query listeners
NORMAL_ADDR=127.0.0.1:8887
VIP_ADDR=127.0.0.1:8888
MAX_QUERY_COUNT=100
NEWS_CATEGORIES=时政,科技,财经,文旅,社会,商业,教育,健康,国际

# These ports always bind to 127.0.0.1
COLLECTOR_PORT=8886
ADMIN_PORT=8889

# Storage and analysis worker
DATABASE_PATH=./data/newsscope.db
ANALYSIS_WORKERS=3
ANALYSIS_MAX_ATTEMPTS=5
ANALYSIS_TIMEOUT_SECONDS=45
ANALYSIS_MAX_BODY_CHARS=12000
